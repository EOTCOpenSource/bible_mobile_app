<?xml version="1.0" encoding="utf-8"?>
<!--
  Daily verse, 2×2 up to 4×2.

  One layout for both sizes rather than two: the only difference is how many
  lines of verse fit, and `layout_weight` on the verse plus maxLines=6 lets the
  same tree collapse gracefully. A second layout would double the places the
  Ethiopic font has to be remembered.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/verse_ref"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/ethiopic_bold"
            android:textColor="@color/widget_primary"
            android:textSize="13sp"
            tools:text="ኤር 29:11" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/widget_daily_verse_badge"
            android:textColor="@color/widget_text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/verse_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:maxLines="6"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.25"
        android:fontFamily="@font/ethiopic_body"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        tools:text="እኔ ስለ እናንተ የማስበውን አሳብ አውቃለሁና" />

    <TextView
        android:id="@+id/verse_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:visibility="gone"
        android:fontFamily="@font/ethiopic_body"
        android:text="@string/widget_open_app"
        android:textColor="@color/widget_text_muted"
        android:textSize="13sp" />

</LinearLayout>
