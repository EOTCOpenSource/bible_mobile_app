<?xml version="1.0" encoding="utf-8"?>
<!--
  Continue reading, 2×1 up to 5×2.

  Tapping anywhere resumes the last position, so the whole root carries the
  PendingIntent rather than a button — a widget this small has no room for a
  tap target that is smaller than itself.

  See widget_daily_verse.xml for why the background is an ImageView and why
  there is one layout rather than one per size.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:src="@drawable/widget_card_light" />

    <ImageView
        android:id="@+id/widget_disc"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-64dp"
        android:layout_marginEnd="-48dp"
        android:visibility="gone"
        android:contentDescription="@null"
        android:src="@drawable/widget_disc" />

    <LinearLayout
        android:id="@+id/continue_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/continue_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/ethiopic_body"
            android:textColor="@color/widget_text_muted"
            android:textSize="10sp"
            android:text="@string/widget_continue_label" />

        <TextView
            android:id="@+id/continue_book"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="@font/ethiopic_bold"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            tools:text="መጽሐፈ ነገሥት ቀዳማዊ" />

        <TextView
            android:id="@+id/continue_ref"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/ethiopic_body"
            android:textColor="@color/widget_primary"
            android:textSize="12sp"
            tools:text="ምዕ. 8" />

        <!--
          Two stacked ImageViews rather than a ProgressBar: RemoteViews can only
          set a ProgressBar's value, not tint it per theme below API 31, while
          both a clip drawable's level and an ImageView's colour filter are
          settable from RemoteViews on every version we ship to.
        -->
        <FrameLayout
            android:id="@+id/continue_bar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/continue_track"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="@null"
                android:src="@drawable/widget_progress_track" />

            <ImageView
                android:id="@+id/continue_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="@null"
                android:src="@drawable/widget_progress_fill" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/continue_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="14dp"
        android:visibility="gone"
        android:fontFamily="@font/ethiopic_body"
        android:text="@string/widget_start_reading"
        android:textColor="@color/widget_text_muted"
        android:textSize="13sp" />

</FrameLayout>
