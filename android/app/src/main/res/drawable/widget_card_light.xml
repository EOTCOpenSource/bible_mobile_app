<?xml version="1.0" encoding="utf-8"?>
<!--
  The light card, one of the three a widget can be told to draw.

  Three drawables rather than one tinted at runtime: RemoteViews inflates a
  drawable in the launcher's configuration, so a single @color/widget_background
  card would follow the launcher's night mode no matter which theme the user
  picked. Naming the palette in the drawable is the only way "always light"
  can survive a dark launcher.

  The 20dp radius is a fixed value rather than
  @android:dimen/system_app_widget_background_radius because that dimension
  only exists from API 31. Launchers on 12+ clip widgets to their own corner
  radius anyway, so a slightly rounder card is invisible there and still looks
  deliberate on 8–11, where nothing is clipped for us.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_light_bg" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_light_border" />
</shape>
