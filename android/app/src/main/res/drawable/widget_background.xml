<?xml version="1.0" encoding="utf-8"?>
<!--
  The card every widget sits on.

  The 16dp radius is a fixed value rather than @android:dimen/system_app_widget_background_radius
  because that dimension only exists from API 31. Launchers on 12+ clip widgets
  to their own corner radius anyway, so a slightly rounder card is invisible
  there and still looks deliberate on 8–11, where nothing is clipped for us.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_background" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_border" />
</shape>
