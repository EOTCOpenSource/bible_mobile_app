<?xml version="1.0" encoding="utf-8"?>
<!--
  The maroon card, mirroring the home screen's daily verse.

  The gold hairline is the one thing the on-screen card does not have: on the
  home screen the card sits on parchment and casts a shadow, and a widget can
  do neither, so an edge is what keeps it from bleeding into a dark wallpaper.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_brand_bg" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_brand_border" />
</shape>
